# PostgreSQL
POSTGRES_USER=mylinks
POSTGRES_PASSWORD=mylinks_dev
POSTGRES_DB=mylinks
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Database URL (used by golang-migrate and the API)
DATABASE_URL=postgres://mylinks:mylinks_dev@localhost:5434/mylinks?sslmode=disable

# API (Go / Fiber)
API_PORT=8080
SCRAPER_URL=http://localhost:8081

# Scraper (Rust / Axum)
SCRAPER_PORT=8081
