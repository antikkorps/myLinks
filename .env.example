# PostgreSQL
POSTGRES_USER=mylinks
POSTGRES_PASSWORD=mylinks_dev
POSTGRES_DB=mylinks
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Database URL (used by golang-migrate and the API)
DATABASE_URL=postgres://mylinks:mylinks_dev@localhost:5434/mylinks?sslmode=disable

# API (Go / Fiber)
API_PORT=8080
SCRAPER_URL=http://localhost:8081

# Scraper (Rust / Axum)
SCRAPER_PORT=8081

# JWT Secret (used for signing JWT tokens in the API)
# penssl rand -base64 48 to generate a random 32+ byte string
JWT_SECRET=change-me-to-a-random-32+-byte-string

# Cookies & CORS (web SPA at WEB_ORIGIN talks to the API)
# In dev over HTTP, COOKIE_SECURE must be false so the browser stores the cookie.
# In prod (HTTPS), leave it true (default).
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000